
{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://your-oracle-vm.com/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "X-CSRFToken, Content-Type"
      }
    },
    {
      "src": "/ws/(.*)",
      "dest": "wss://your-oracle-vm.com/ws/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://your-oracle-vm.com",
    "REACT_APP_WS_URL": "wss://your-oracle-vm.com"
  }
}